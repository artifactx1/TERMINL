{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/arcade/Dockerfile",
    "watchPatterns": ["/server/arcade/**", "/lib/arcade/**"]
  },
  "deploy": {
    "startCommand": "node server/arcade/index.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
