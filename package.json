{
  "name": "terminl",
  "version": "1.0.0",
  "private": true,
  "description": "Mint site for TERMINL — 2048 generative CRT terminals, stored permanently on Arweave.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "test:os": "node --test scripts/terminl-game.test.mjs scripts/moon-mission.test.mjs",
    "test:rug-or-bond": "node --test scripts/rug-or-bond.test.mjs",
    "test:rug-or-bond:browser": "node scripts/rug-or-bond-browser.mjs",
    "test:moon:browser": "node scripts/moon-browser.mjs",
    "dev:arcade": "ARCADE_LABS=1 next dev -p 4000",
    "arcade:server": "node server/arcade/index.mjs",
    "test:arcade": "node --test scripts/rumble-sim.test.mjs scripts/rumble-roster.test.mjs scripts/race-sim.test.mjs scripts/race-art.test.mjs scripts/touch-input.test.mjs scripts/arcade-server.test.mjs",
    "test:touch:browser": "node scripts/touch-browser.mjs",
    "test:race:smoke": "node scripts/race-smoke.mjs",
    "test:race:browser": "node scripts/race-browser.mjs",
    "test:race:online-smoke": "node scripts/grand-tour-browser.mjs",
    "test:arcade:browser": "node scripts/arcade-browser.mjs",
    "validate:arcade-assets": "node scripts/validate-arcade-assets.mjs",
    "validate:arcade-catalog": "node scripts/validate-arcade-catalog.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "upload-art": "node scripts/upload-art.mjs",
    "og": "node scripts/og.mjs",
    "verify-calldata": "node scripts/verify-calldata.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.8",
    "@metamask/connect-evm": "^1.0.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.101.4",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "accounts": "^0.8.10",
    "next": "14.2.35",
    "porto": "^0.2.37",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4",
    "viem": "^2.48.4",
    "wagmi": "^3.6.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "playwright": "1.63.0"
  },
  "overrides": {
    "@wagmi/core": "3.4.7",
    "@wagmi/connectors": "8.0.8"
  }
}
