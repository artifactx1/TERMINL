{
  "name": "terminl",
  "version": "1.0.0",
  "private": true,
  "description": "Mint site for TERMINL \u2014 2048 generative CRT terminals, stored permanently on Arweave.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "test:mint": "node --test scripts/mint-quantity.test.mjs scripts/mint-reliability.test.mjs",
    "test:mint:browser": "node scripts/mint-quantity-browser.mjs",
    "test:mint:flow": "node scripts/mint-flow-browser.mjs",
    "test:mint:load": "node scripts/mint-load.mjs",
    "check:mint": "node scripts/mint-readiness.mjs",
    "test:os": "node --test scripts/terminl-game.test.mjs scripts/moon-mission.test.mjs scripts/moon-campaign.test.mjs",
    "test:rug-or-bond": "node --test scripts/rug-or-bond.test.mjs",
    "test:rug-or-bond:browser": "node scripts/rug-or-bond-browser.mjs",
    "test:moon:browser": "node scripts/moon-browser.mjs",
    "dev:arcade": "ARCADE_LABS=1 next dev -p 4000",
    "arcade:server": "node server/arcade/index.mjs",
    "test:arcade": "node --test scripts/mall-camera.test.mjs scripts/mall-upgrade.test.mjs scripts/after-hours.test.mjs scripts/rumble-finishers.test.mjs scripts/arcade-transport.test.mjs scripts/rumble-sim.test.mjs scripts/rumble-roster.test.mjs scripts/race-sim.test.mjs scripts/race-rival.test.mjs scripts/race-art.test.mjs scripts/race-visibility.test.mjs scripts/touch-input.test.mjs scripts/rumble-controls.test.mjs scripts/arcade-server.test.mjs scripts/rumble-circuit.test.mjs",
    "test:touch:browser": "node scripts/touch-browser.mjs",
    "test:race:visibility": "node scripts/race-visibility-browser.mjs",
    "test:race:smoke": "node scripts/race-smoke.mjs",
    "test:race:browser": "node scripts/race-browser.mjs",
    "test:race:online-smoke": "node scripts/grand-tour-browser.mjs",
    "test:arcade:browser": "node scripts/arcade-browser.mjs",
    "validate:arcade-assets": "node scripts/validate-arcade-assets.mjs",
    "validate:arcade-catalog": "node scripts/validate-arcade-catalog.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "upload-art": "node scripts/upload-art.mjs",
    "og": "node scripts/og.mjs",
    "verify-calldata": "node scripts/verify-calldata.mjs",
    "test:arcade:v1": "node scripts/arcade-v1-browser.mjs",
    "test:rumble:circuit:browser": "node scripts/rumble-circuit-browser.mjs",
    "test:rumble:art:browser": "node scripts/rumble-art-browser.mjs",
    "test:controls:browser": "node scripts/control-release-browser.mjs",
    "test:csp": "node --test scripts/csp.test.mjs",
    "test:csp:browser": "node scripts/csp-browser.mjs",
    "test:after-hours": "node --test scripts/mall-camera.test.mjs scripts/mall-upgrade.test.mjs scripts/after-hours.test.mjs",
    "test:after-hours:routes": "node scripts/after-hours-pilot.mjs --output=/tmp/terminl-rug-plans.json",
    "test:after-hours:browser": "npm run test:after-hours:routes && node scripts/after-hours-browser.mjs",
    "test:after-hours:touch": "node scripts/mall-park-browser.mjs && node scripts/rug-touch-browser.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.8",
    "@metamask/connect-evm": "^1.0.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.101.4",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "accounts": "^0.8.10",
    "next": "14.2.35",
    "porto": "^0.2.37",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4",
    "three": "0.180.0",
    "viem": "^2.48.4",
    "wagmi": "^3.6.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "playwright": "1.63.0"
  },
  "overrides": {
    "@wagmi/core": "3.4.7",
    "@wagmi/connectors": "8.0.8"
  }
}
