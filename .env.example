# Only "npm run snapshot" reads this. The site never does, and it is not needed
# to build or deploy — it is the path to the locked collection on the machine
# where you regenerate the published pieces.
TERMINL_COLLECTION_DIR=../ELEMENT/nft-projects/tickerbots/v2/output/collection-2048-terminl

# The deployed drop. Until this is set the page shows an inert "MINT OPENS
# SOON" panel — it never renders a mint button that cannot work.
# NEXT_PUBLIC_TERMINL_CONTRACT=0x...

# Robinhood Chain: 4663 mainnet (default), 46630 testnet. Price, supply, the
# per-wallet cap and the minted count are all read from the contract, so none
# of them are configured here.
# NEXT_PUBLIC_CHAIN_ID=4663

# Public browser/wallet chain RPC. Do not put a private provider key here.
# NEXT_PUBLIC_RPC_URL=

# Private server RPC, used by the cached drop route and restricted mint reads.
# Store the real value in .env.local or hosting settings; never commit the key.
# RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>
# ALLOWLIST_API_URL=https://artifactxserver-production.up.railway.app

# Where the 16 published images are served from. Unset falls back to the copies
# committed under public/art, so a deploy without it still works.
NEXT_PUBLIC_ART_BASE_URL=https://storage.googleapis.com/curent-marketplace/terminl/art

# The production domain. Only affects og:url and the canonical link, both of
# which are omitted when this is unset.
# NEXT_PUBLIC_SITE_URL=https://terminl.net

# The share card. Defaults to the copy on the ELEMENT bucket, which is already
# absolute and stable — override only if you want it served from your domain.
# NEXT_PUBLIC_OG_IMAGE=https://terminl.net/og.jpg
